# Copy this file to .env for local docker-compose overrides. Optional -
# docker-compose.yml already has sensible defaults, so you only need a
# .env if you want different local credentials.
#
# For Railway: do NOT use this file. Railway does not read .env from your
# repo. Set SPRING_DATASOURCE_URL / SPRING_DATASOURCE_USERNAME /
# SPRING_DATASOURCE_PASSWORD directly as service variables in the Railway
# dashboard, referencing the Postgres plugin's connection details. See the
# "Deploying to Railway" section in README.md for the exact steps.

# --- Local docker-compose Postgres (the `db` service) ---
POSTGRES_DB=wallet
POSTGRES_USER=wallet
POSTGRES_PASSWORD=changeme

# --- Only needed if running the app OUTSIDE docker-compose, e.g.
# `mvn spring-boot:run` against a Postgres you started yourself ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wallet
# SPRING_DATASOURCE_USERNAME=wallet
# SPRING_DATASOURCE_PASSWORD=changeme
